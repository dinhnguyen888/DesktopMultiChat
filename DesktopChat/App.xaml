<Application
    x:Class="DesktopChat.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DesktopChat.Converters"
    xmlns:local="clr-namespace:DesktopChat"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!--  Converter  -->
            <converters:TextToHyperlinkTextBlockConverter x:Key="TextToHyperlinkTextBlockConverter" />
            <converters:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />

            <!--  Custom Tooltip  -->
            <Style TargetType="FrameworkElement">
                <Setter Property="ToolTipService.InitialShowDelay" Value="50" />
                <Setter Property="ToolTipService.ShowDuration" Value="10000" />
                <Setter Property="ToolTipService.Placement" Value="Mouse" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>