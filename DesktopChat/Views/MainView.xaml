<UserControl
    x:Class="DesktopChat.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="clr-namespace:DesktopChat.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:view="clr-namespace:DesktopChat.Views"
    xmlns:vm="clr-namespace:DesktopChat.ViewModels"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <ui:NavigationView
            x:Name="RootNavigation"
            IsBackButtonVisible="Auto"
            Loaded="RootNavigation_Loaded">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    x:Name="DashboardItem"
                    Content="Dashboard"
                    TargetPageType="{x:Type pages:DashboardPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home32" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Room" TargetPageType="{x:Type pages:RMsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DeviceMeetingRoom32" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="DMs" TargetPageType="{x:Type pages:DMsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Chat32" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!--<ui:NavigationViewItem Content="Task Management" TargetPageType="{x:Type view:RoomView}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="TaskListLtr24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Notification" TargetPageType="{x:Type view:RoomView}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Alert32" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>-->

                <ui:NavigationViewItem Content="Profile Setting" TargetPageType="{x:Type pages:SettingPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings32" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>


    </Grid>
</UserControl>
