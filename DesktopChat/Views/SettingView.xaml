<UserControl
    x:Class="DesktopChat.Views.SettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DesktopChat.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="20" Background="#333">
        <!--  ✅ Đặt style để TextBlock và các phần tử văn bản khác có màu trắng  -->
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
            </Style>
        </Grid.Resources>

        <Border
            Padding="20"
            BorderBrush="#ddd"
            BorderThickness="1"
            CornerRadius="10">
            <StackPanel
                Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <!--  Avatar  -->
                <Image
                    Width="100"
                    Height="100"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Center"
                    Source="/Assets/avatar.png"
                    Stretch="UniformToFill" />

                <!--  Thông tin người dùng  -->
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="Họ và Tên:" />
                    <TextBlock Margin="0,0,0,10" Text="{Binding UserName}" />

                    <TextBlock FontWeight="Bold" Text="Email:" />
                    <TextBlock Margin="0,0,0,10" Text="{Binding Email}" />
                </StackPanel>

                <!--  Nút hành động  -->
                <StackPanel
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="120"
                        Background="#E53935"
                        Command="{Binding LogoutCommand}"
                        Content="Đăng xuất"
                        Foreground="White" />
                    <!--  👈 Giữ nguyên cho Button  -->

                    <Button
                        Width="150"
                        Background="#1976D2"
                        Command="{Binding EditProfileCommand}"
                        Content="Thay đổi thông tin"
                        Foreground="White" />

                    <Button
                        Width="120"
                        Background="#43A047"
                        Command="{Binding ChangePasswordCommand}"
                        Content="Đổi mật khẩu"
                        Foreground="White" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
