<UserControl
    x:Class="DesktopChat.Views.ChatBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DesktopChat.ViewModels">

    <Border
        Margin="6"
        Padding="12"
        Background="#17212B"
        BorderBrush="#192734"
        BorderThickness="1"
        CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Room Header  -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,8"
                Padding="10,6"
                Background="#17212B"
                BorderBrush="#232E3C"
                BorderThickness="0,0,0,1"
                CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        FontSize="18"
                        Foreground="#0078D7"
                        Symbol="Chat24" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding MessageEntity.MessageEntityName}" />
                </StackPanel>
            </Border>

            <!--  Message List  -->
            <ScrollViewer
                x:Name="MessagesScrollViewer"
                Grid.Row="1"
                Background="Transparent"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <StackPanel Orientation="Vertical">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatBoxVM}">
                                <Border
                                    Margin="8"
                                    Padding="10,8"
                                    Background="#242F3D"
                                    CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--  Sender Info  -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <TextBlock
                                                FontWeight="Bold"
                                                Foreground="#88A0B9"
                                                Text="{Binding SenderName}" />
                                            <TextBlock Foreground="#6D839F" Text=" • " />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#6D839F"
                                                Text="{Binding SentTime, StringFormat='{}{0:HH:mm}'}" />
                                        </StackPanel>

                                        <!--  Message Content  -->
                                        <!--  Message Content  -->
                                        <ContentControl
                                            Grid.Row="1"
                                            Margin="0,4,0,0"
                                            Content="{Binding MessageText, Converter={StaticResource TextToHyperlinkTextBlockConverter}}">
                                            <ContentControl.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="14" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                </Style>
                                            </ContentControl.Resources>
                                        </ContentControl>

                                        <!--  Delete Button  -->
                                        <ui:Button
                                            Grid.Row="2"
                                            Margin="0,4,0,0"
                                            Padding="4,2"
                                            HorizontalAlignment="Right"
                                            Background="Transparent"
                                            Command="{Binding DataContext.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Foreground="#FF6B6B"
                                            Icon="{ui:SymbolIcon Delete24}"
                                            Visibility="Visible" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>


            <!--  Message Input  -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Message Input Box  -->
                <Border
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Background="#404040"
                    CornerRadius="8">
                    <ui:TextBox
                        Name="Msg_Input"
                        Padding="10"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        PlaceholderText="Type your message..."
                        Text="{Binding NewMessage, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SendMessageCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>

                </Border>

                <!--  Send File Button  -->
                <ui:HyperlinkButton
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Command="{Binding UploadFileCommand}"
                    Content="Upload..."
                    Icon="{ui:SymbolIcon Link24}" />
                <!--  Send Message Button  -->
                <ui:Button
                    Name="SendBtn"
                    Grid.Column="2"
                    MinWidth="80"
                    VerticalAlignment="Stretch"
                    Appearance="Primary"
                    Command="{Binding SendMessageCommand}"
                    Content="Send"
                    CornerRadius="8"
                    Icon="{ui:SymbolIcon Send24}" />



            </Grid>

        </Grid>
    </Border>
</UserControl>