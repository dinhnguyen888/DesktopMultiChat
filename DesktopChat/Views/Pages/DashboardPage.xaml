<Page
    x:Class="DesktopChat.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DesktopChat.Views.Pages"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DashboardPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Background="#17212B">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Danh sách tài khoản online  -->
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Margin="12,12,12,6"
            Background="#242F3D"
            BorderBrush="#232E3C"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Online accounts" />
                        <TextBlock
                            Margin="12,0,0,0"
                            FontSize="16"
                            Foreground="#4CAF50">
                            <Run Text="(" />
                            <Run Text="{Binding OnlineAccountCount}" />
                            <Run Text=")" />
                        </TextBlock>
                    </StackPanel>

                    <ui:Button
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        Padding="8,4"
                        Background="#0078D7"
                        BorderThickness="0"
                        Command="{Binding RefreshCommand}"
                        Foreground="White"
                        Icon="{ui:SymbolIcon ArrowClockwise24}"
                        ToolTip="Refresh online status" />

                </Grid>

                <ListView
                    Grid.Row="1"
                    Margin="8,0,8,8"
                    Background="#17212B"
                    BorderThickness="0"
                    ItemsSource="{Binding OnlineAccountViews}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Background" Value="#242F3D" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Trạng thái Online  -->
                                <Ellipse
                                    Grid.Column="0"
                                    Width="12"
                                    Height="12"
                                    Margin="4,0,12,0"
                                    Fill="Green" />

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Vertical">
                                    <!--  Tên người dùng  -->
                                    <TextBlock
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{Binding FullName}" />
                                    <!--  Vai trò  -->
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#FFAAAAAA"
                                        Text="{Binding Role}" />
                                </StackPanel>

                                <!--  Nút Message  -->
                                <ui:Button
                                    Grid.Column="2"
                                    Margin="4,0"
                                    Background="#0078D7"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.MessageAccountCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding AccountId}"
                                    Icon="{ui:SymbolIcon Chat24}"
                                    ToolTip="Message" />
                            </Grid>
                        </DataTemplate>

                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!--  Danh sách Room  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="12,6,12,12"
            Background="#242F3D"
            BorderBrush="#232E3C"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Rooms" />

                </Grid>

                <ListView
                    Grid.Row="1"
                    Margin="8,0,8,8"
                    Background="#17212B"
                    BorderThickness="0"
                    ItemsSource="{Binding Rooms}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Background" Value="#242F3D" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Text="{Binding RoomName}" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:Button
                                        Margin="4,0"
                                        Background="#6D839F"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.EditRoomCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}"
                                        Icon="{ui:SymbolIcon Chat24}"
                                        ToolTip="Edit" />

                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!--  Biểu đồ tiến độ công việc  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Margin="12,12,12,12"
            Background="#242F3D"
            BorderBrush="#232E3C"
            BorderThickness="1"
            CornerRadius="8">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Tiến độ công việc" />

                <!--  Biểu đồ tròn  -->
                <Border
                    Grid.Row="1"
                    Margin="0,16,0,12"
                    Padding="16"
                    Background="#17212B"
                    BorderBrush="#192734"
                    BorderThickness="1"
                    CornerRadius="8">
                    <lvc:PieChart
                        Height="220"
                        Foreground="White"
                        LegendLocation="Right"
                        Series="{Binding OverallProgressSeries}">
                        <lvc:PieChart.DataTooltip>
                            <lvc:DefaultTooltip
                                Background="#242F3D"
                                FontSize="14"
                                Foreground="White" />
                        </lvc:PieChart.DataTooltip>
                    </lvc:PieChart>
                </Border>

                <!--  Biểu đồ cột ngang  -->
                <Border
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    Padding="16"
                    Background="#17212B"
                    BorderBrush="#192734"
                    BorderThickness="1"
                    CornerRadius="8">
                    <lvc:CartesianChart
                        Height="220"
                        Foreground="White"
                        LegendLocation="Right"
                        Series="{Binding IndividualProgressSeries}">
                        <lvc:CartesianChart.DataTooltip>
                            <lvc:DefaultTooltip
                                Background="#242F3D"
                                FontSize="14"
                                Foreground="White" />
                        </lvc:CartesianChart.DataTooltip>
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis
                                Title="Tên nhân viên"
                                Foreground="#88A0B9"
                                Labels="{Binding EmployeeNames}" />
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis
                                Title="Tiến độ (%)"
                                Foreground="#88A0B9"
                                LabelFormatter="{Binding YFormatter}" />
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
