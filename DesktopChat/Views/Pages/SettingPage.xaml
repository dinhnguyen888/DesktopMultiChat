<Page
    x:Class="DesktopChat.Views.Pages.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DesktopChat.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="SettingPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="20" Background="#2B2B2B">
        <!--  ✅ Style chung cho TextBlock  -->
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#EEEEEE" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <!--  Khoảng cách dưới label  -->
            </Style>

            <!--  ✅ Style cho Button  -->
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.9" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect
                                    BlurRadius="8"
                                    ShadowDepth="2"
                                    Color="#000000" />
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  ✅ Style cho TextBox  -->
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="#EEEEEE" />
                <Setter Property="Background" Value="#444444" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <!--  Khoảng cách dưới field  -->
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="BorderBrush" Value="#555555" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </Grid.Resources>

        <!--  🎯 Khung chứa form  -->
        <Border
            Padding="30"
            Background="#3A3A3A"
            BorderBrush="#4F4F4F"
            BorderThickness="1"
            CornerRadius="15">
            <StackPanel Width="450" HorizontalAlignment="Center">
                <ui:TextBlock
                    FontTypography="Title"
                    Foreground="White"
                    Text="Personal Information"
                    TextAlignment="Center" />

                <!--  👤 Họ và Tên  -->
                <Label Content="Name" />
                <ui:TextBox Text="{Binding FullName, Mode=TwoWay}" />

                <!--  ✉️ Email  -->
                <Label Content="Email" />
                <ui:TextBox Text="{Binding Email, Mode=TwoWay}" />

                <!--  📅 Ngày sinh  -->
                <Label Content="Day Of Birth" />
                <DatePicker
                    Margin="0,0,0,12"
                    SelectedDate="{Binding DateBirth, Mode=TwoWay}"
                    Text="{Binding DateBirth}" />

                <!--  ☎️ Số điện thoại  -->
                <Label Content="Phone Number" />
                <ui:TextBox Text="{Binding PhoneNumber, Mode=TwoWay}" />

                <!--  🏆 Vai trò  -->
                <Label Content="Role" />
                <TextBox IsReadOnly="True" Text="{Binding Role, Mode=TwoWay}" />

                <!--  🚀 Nút hành động  -->
                <StackPanel
                    Margin="20,20,20,20"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">

                    <!--  🔵 Nút Lưu thông tin  -->
                    <ui:Button
                        Margin="0,10,0,0"
                        Background="#1976D2"
                        Command="{Binding SaveProfileCommand}"
                        Content="Save Information">
                        <ui:Button.Effect>
                            <DropShadowEffect
                                BlurRadius="6"
                                ShadowDepth="2"
                                Color="#000000" />
                        </ui:Button.Effect>
                    </ui:Button>

                    <!--  🟢 Nút Đổi mật khẩu  -->
                    <ui:Button
                        Margin="0,10,0,0"
                        Background="#43A047"
                        Command="{Binding ChangePasswordCommand}"
                        Content="Change Password">
                        <ui:Button.Effect>
                            <DropShadowEffect
                                BlurRadius="6"
                                ShadowDepth="2"
                                Color="#000000" />
                        </ui:Button.Effect>
                    </ui:Button>

                    <!--  🔴 Nút Đăng xuất  -->
                    <ui:Button
                        Margin="0,10,0,0"
                        Background="#E53935"
                        Command="{Binding LogoutCommand}"
                        Content="Logout">
                        <ui:Button.Effect>
                            <DropShadowEffect ShadowDepth="2" Color="#000000" />
                        </ui:Button.Effect>
                    </ui:Button>

                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
