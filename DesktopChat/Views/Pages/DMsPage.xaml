<UserControl
    x:Class="DesktopChat.Views.Pages.DMsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DesktopChat.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:DesktopChat.Views"
    xmlns:vm="clr-namespace:DesktopChat.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!--  KHUNG TIN NHẮN  -->
        <views:ChatBox Grid.Column="0" DataContext="{Binding}" />

        <!--  DANH SÁCH TIN NHẮN TRỰC TIẾP  -->
        <Border
            Grid.Column="1"
            Margin="0"
            Padding="5"
            BorderThickness="1"
            CornerRadius="5">
            <StackPanel>
                <ui:ListView
                    MaxHeight="300"
                    Background="#F5F5F5"
                    ItemsSource="{Binding DirectMessages}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding SelectedDirectMessage, Mode=TwoWay}"
                    SelectionMode="Single">

                    <ui:ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DirectMessagesVM}">
                            <Grid Margin="4">
                                <StackPanel
                                    Margin="4"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <!--  Chấm trạng thái (đồng bộ với BooleanToBrushConverter)  -->
                                    <Ellipse
                                        Width="12"
                                        Height="12"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Fill="{Binding IsOnline, Converter={StaticResource BooleanToBrushConverter}}" />

                                    <!--  Tên người nhận  -->
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="{Binding FullName}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
