<UserControl
    x:Class="DesktopChat.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Grid Background="#0F172A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Danh sách tài khoản  -->
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Margin="12"
            Background="#1E293B"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#E2E8F0"
                        Text="Danh sách tài khoản" />
                    <Button
                        Grid.Column="1"
                        Padding="8,4"
                        Background="#3B82F6"
                        BorderThickness="0"
                        Command="{Binding AddAccountCommand}"
                        Foreground="White"
                        ToolTip="Thêm tài khoản mới">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,4,0"
                                FontSize="16"
                                Text="+" />
                            <TextBlock Text="Thêm" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ListView
                    Grid.Row="1"
                    Margin="8,0,8,8"
                    Background="#0F172A"
                    BorderThickness="0"
                    ItemsSource="{Binding Accounts}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Background" Value="#1E293B" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse
                                    Grid.Column="0"
                                    Width="12"
                                    Height="12"
                                    Margin="4,0,12,0"
                                    Fill="{Binding StatusColor}" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="#E2E8F0"
                                    Text="{Binding Username}" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button
                                        Width="32"
                                        Height="32"
                                        Margin="4,0"
                                        Background="#F59E0B"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Sửa">
                                        <TextBlock Foreground="White" Text="✎" />
                                    </Button>
                                    <Button
                                        Width="32"
                                        Height="32"
                                        Background="#EF4444"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Xóa">
                                        <TextBlock
                                            FontSize="16"
                                            Foreground="White"
                                            Text="×" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!--  Danh sách Room  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="12"
            Background="#1E293B"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#E2E8F0"
                        Text="Danh sách Room" />
                    <Button
                        Grid.Column="1"
                        Padding="8,4"
                        Background="#3B82F6"
                        BorderThickness="0"
                        Command="{Binding AddRoomCommand}"
                        Foreground="White"
                        ToolTip="Thêm room mới">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,4,0"
                                FontSize="16"
                                Text="+" />
                            <TextBlock Text="Thêm" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ListView
                    Grid.Row="1"
                    Margin="8,0,8,8"
                    Background="#0F172A"
                    BorderThickness="0"
                    ItemsSource="{Binding Rooms}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Background" Value="#1E293B" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Foreground="#E2E8F0"
                                    Text="{Binding RoomName}" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button
                                        Width="32"
                                        Height="32"
                                        Margin="4,0"
                                        Background="#F59E0B"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.EditRoomCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Sửa">
                                        <TextBlock Foreground="White" Text="✎" />
                                    </Button>
                                    <Button
                                        Width="32"
                                        Height="32"
                                        Background="#EF4444"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.DeleteRoomCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Xóa">
                                        <TextBlock
                                            FontSize="16"
                                            Foreground="White"
                                            Text="×" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!--  Biểu đồ tiến độ công việc  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Margin="12"
            Background="#1E293B"
            CornerRadius="8">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#E2E8F0"
                    Text="Tiến độ công việc" />

                <!--  Biểu đồ tròn  -->
                <Border
                    Grid.Row="1"
                    Margin="0,16,0,12"
                    Padding="16"
                    Background="#0F172A"
                    CornerRadius="8">
                    <lvc:PieChart
                        Height="220"
                        Foreground="#E2E8F0"
                        LegendLocation="Right"
                        Series="{Binding OverallProgressSeries}">
                        <lvc:PieChart.DataTooltip>
                            <lvc:DefaultTooltip
                                Background="#1E293B"
                                FontSize="14"
                                Foreground="#F8FAFC" />
                        </lvc:PieChart.DataTooltip>
                    </lvc:PieChart>
                </Border>

                <!--  Biểu đồ cột ngang  -->
                <Border
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    Padding="16"
                    Background="#0F172A"
                    CornerRadius="8">
                    <lvc:CartesianChart
                        Height="220"
                        Foreground="#E2E8F0"
                        LegendLocation="Right"
                        Series="{Binding IndividualProgressSeries}">
                        <lvc:CartesianChart.DataTooltip>
                            <lvc:DefaultTooltip
                                Background="#1E293B"
                                FontSize="14"
                                Foreground="#F8FAFC" />
                        </lvc:CartesianChart.DataTooltip>
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis
                                Title="Tên nhân viên"
                                Foreground="#E2E8F0"
                                Labels="{Binding EmployeeNames}" />
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis
                                Title="Tiến độ (%)"
                                Foreground="#E2E8F0"
                                LabelFormatter="{Binding YFormatter}" />
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>



                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>