<UserControl
    x:Class="DesktopChat.Views.ChatBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Border
        Margin="6"
        Padding="12"
        Background="#303030"
        BorderBrush="#404040"
        BorderThickness="1"
        CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Room Header  -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,8"
                Padding="10,6"
                Background="#353535"
                CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        FontSize="18"
                        Foreground="#0078D7"
                        Symbol="Chat24" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="{Binding SelectedRoom.RoomName}" />
                </StackPanel>
            </Border>

            <!--  Message List  -->
            <ScrollViewer
                x:Name="MessagesScrollViewer"
                Grid.Row="1"
                ScrollChanged="MessagesScrollViewer_ScrollChanged"
                VerticalScrollBarVisibility="Disabled">

                <ui:ListView
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Messages}">

                    <ui:ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="2"
                                Padding="8"
                                Background="#404040"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  Sender Name  -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="Bold"
                                            Foreground="#B0B0B0"
                                            Text="{Binding SenderName}" />
                                        <TextBlock Foreground="#808080" Text=" • " />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="#808080"
                                            Text="{Binding SentTime, StringFormat='{}{0:HH:mm}'}" />
                                    </StackPanel>

                                    <!--  Message Content  -->
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,4,0,0"
                                        FontSize="14"
                                        Foreground="#FFFFFF"
                                        Text="{Binding MessageText}"
                                        TextWrapping="Wrap" />


                                    <!--  Delete Button  -->
                                    <Button
                                        Grid.Row="2"
                                        Margin="0,4,0,0"
                                        Padding="4,2"
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="Delete"
                                        Foreground="#FF6B6B"
                                        Visibility="Visible" />

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>
            </ScrollViewer>

            <!--  Message Input  -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Message Input Box  -->
                <Border
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Background="#404040"
                    CornerRadius="8">
                    <ui:TextBox
                        Padding="10"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        PlaceholderText="Type your message..."
                        Text="{Binding NewMessage, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SendMessageCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                </Border>

                <!--  Send Button  -->
                <ui:Button
                    Grid.Column="1"
                    MinWidth="80"
                    VerticalAlignment="Stretch"
                    Appearance="Primary"
                    Command="{Binding SendMessageCommand}"
                    Content="Send"
                    CornerRadius="8"
                    Icon="{ui:SymbolIcon Send24}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>