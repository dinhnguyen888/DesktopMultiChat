<UserControl
    x:Class="DesktopChat.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:DesktopChat.Views"
    xmlns:vm="clr-namespace:DesktopChat.ViewModels">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!--  Gọi khung chat vào  -->
        <views:ChatBox Grid.Column="0" DataContext="{Binding}" />


        <!--  DANH SÁCH ROOM  -->
        <Border
            Grid.Column="1"
            Margin="0"
            Padding="5"
            BorderThickness="1"
            CornerRadius="5">
            <StackPanel>
                <ui:ListView
                    MaxHeight="300"
                    Background="#F5F5F5"
                    ItemsSource="{Binding Rooms}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ui:ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChatVM}">
                            <Grid Margin="4">
                                <StackPanel Margin="4">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Text="{Binding RoomName}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="Gray"
                                        Text="{Binding MemberCount, StringFormat='Thành viên: {0}'}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="Green"
                                        Text="{Binding OnlineUserCount, StringFormat='Online: {0}'}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
