<UserControl
    x:Class="DesktopChat.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DesktopChat.Views"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!--  Background Image with 80% opacity  -->
        <Image
            Opacity="0.8"
            Source="/Assets/login-background.jpg"
            Stretch="Fill" />

        <!--  Black overlay with 80% opacity  -->
        <Rectangle Fill="Black" Opacity="0.8" />

        <!--  Login Form centered on top  -->
        <StackPanel
            Width="400"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <ui:TextBlock
                Margin="0,0,0,20"
                FontTypography="Title"
                Foreground="White"
                Text="Welcome back"
                TextAlignment="Center" />
            <ui:TextBox
                Width="400"
                Margin="0,0,0,20"
                PlaceholderText="Email"
                Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
            <ui:PasswordBox
                Name="textPassword"
                Width="400"
                Margin="0,0,0,20"
                PasswordChanged="textPassword_PasswordChanged"
                PlaceholderEnabled="True"
                PlaceholderText="Password..." />
            <ui:Button
                Width="400"
                Margin="0,0,0,20"
                Appearance="Primary"
                Command="{Binding LoginCommand}"
                Content="Đăng nhập" />
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsHidden, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </Grid>
</UserControl>