<Window
    x:Class="DesktopChat.Views.Windows.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DesktopChat.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="800"
    Height="450"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <ui:TitleBar Title="Login window" />
        <Image
            Opacity="0.8"
            Source="/Assets/login-background.jpg"
            Stretch="Fill" />
        <!--  Black overlay with 80% opacity  -->
        <Rectangle Fill="Black" Opacity="0.9" />

        <!--  Login Form centered on top  -->
        <StackPanel
            Width="400"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <ui:TextBlock
                Margin="0,0,0,20"
                FontTypography="Title"
                Foreground="White"
                Text="Welcome back"
                TextAlignment="Center" />
            <ui:TextBox
                Width="400"
                Margin="0,0,0,20"
                PlaceholderText="Email"
                Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
            <ui:PasswordBox
                Name="textPassword"
                Width="400"
                Margin="0,0,0,20"
                PasswordChanged="textPassword_PasswordChanged"
                PlaceholderEnabled="True"
                PlaceholderText="Password..." />
            <ui:Button
                Width="400"
                Margin="0,0,0,20"
                Appearance="Primary"
                Command="{Binding LoginCommand}"
                Content="Login"
                Cursor="Hand" />
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsHidden, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </Grid>
</Window>
