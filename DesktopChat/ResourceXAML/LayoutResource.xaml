<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:view="clr-namespace:DesktopChat.Views">
    <ControlTemplate x:Key="SidebarTemplate" TargetType="ContentControl">
        <Grid>

            <ui:NavigationView IsBackButtonVisible="Auto">

                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="Dashboard" TargetPageType="{x:Type view:DashboardView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Home32" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Chat" TargetPageType="{x:Type view:ChatView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Chat32" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Video Call" TargetPageType="{x:Type view:RoomView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Call32" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Task Management" TargetPageType="{x:Type view:RoomView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="TaskListLtr24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Notification" TargetPageType="{x:Type view:RoomView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Alert32" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="Profile Setting" TargetPageType="{x:Type view:SettingView}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings32" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>
            </ui:NavigationView>


        </Grid>
    </ControlTemplate>
</ResourceDictionary>